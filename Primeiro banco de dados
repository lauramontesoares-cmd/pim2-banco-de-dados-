-- ============================================================
-- PIM II - CONSIGAZ
-- Banco de Dados
-- ============================================================

-- 1. CRIAÇÃO DO BANCO
CREATE DATABASE IF NOT EXISTS pim_consigaz;

USE pim_consigaz;


-- ============================================================
-- 2. TABELA DE USUÁRIOS
-- Funcionários do sistema
-- Níveis: Administrador, Atendente e Entregador
-- ============================================================

CREATE TABLE usuarios (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    login VARCHAR(50) NOT NULL UNIQUE,
    senha VARCHAR(255) NOT NULL,
    nivel ENUM(
        'ADMINISTRADOR',
        'ATENDENTE',
        'ENTREGADOR'
    ) NOT NULL,
    ativo BOOLEAN NOT NULL DEFAULT TRUE
);


-- ============================================================
-- 3. TABELA DE CLIENTES
-- Clientes podem realizar pedidos
-- ============================================================

CREATE TABLE clientes (
    id_cliente INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    login VARCHAR(50) NOT NULL UNIQUE,
    senha VARCHAR(255) NOT NULL,
    telefone VARCHAR(20) NOT NULL,
    endereco VARCHAR(200) NOT NULL,
    ativo BOOLEAN NOT NULL DEFAULT TRUE
);


-- ============================================================
-- 4. TABELA DE PRODUTOS
-- Tipos de botijão comercializados
-- ============================================================

CREATE TABLE produtos (
    id_produto INT AUTO_INCREMENT PRIMARY KEY,
    tipo ENUM('P13', 'P20', 'P45') NOT NULL UNIQUE,
    preco DECIMAL(10,2) NOT NULL,
    ativo BOOLEAN NOT NULL DEFAULT TRUE,

    CHECK (preco >= 0)
);


-- ============================================================
-- 5. TABELA DE ESTOQUE
-- Armazena a quantidade disponível de cada produto
-- ============================================================

CREATE TABLE estoque (
    id_estoque INT AUTO_INCREMENT PRIMARY KEY,
    id_produto INT NOT NULL UNIQUE,
    quantidade INT NOT NULL DEFAULT 0,

    FOREIGN KEY (id_produto)
        REFERENCES produtos(id_produto),

    CHECK (quantidade >= 0)
);


-- ============================================================
-- 6. TABELA DE PEDIDOS
-- Cada pedido pertence a um cliente
-- id_usuario identifica o funcionário que criou o pedido,
-- quando o pedido for criado por um funcionário.
-- ============================================================

CREATE TABLE pedidos (
    id_pedido INT AUTO_INCREMENT PRIMARY KEY,

    id_cliente INT NOT NULL,
    id_usuario INT NULL,

    data_pedido DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    status ENUM(
        'PENDENTE',
        'EM_SEPARACAO',
        'SAIU_PARA_ENTREGA',
        'ENTREGUE',
        'CANCELADO'
    ) NOT NULL DEFAULT 'PENDENTE',

    forma_pagamento ENUM(
        'PIX',
        'CREDITO',
        'DEBITO'
    ) NOT NULL,

    endereco_entrega VARCHAR(200) NOT NULL,

    valor_total DECIMAL(10,2) NOT NULL DEFAULT 0,

    FOREIGN KEY (id_cliente)
        REFERENCES clientes(id_cliente),

    FOREIGN KEY (id_usuario)
        REFERENCES usuarios(id_usuario)
);


-- ============================================================
-- 7. TABELA DE ITENS DO PEDIDO
-- Um pedido pode possuir vários produtos.
-- ============================================================

CREATE TABLE itens_pedido (
    id_item INT AUTO_INCREMENT PRIMARY KEY,

    id_pedido INT NOT NULL,
    id_produto INT NOT NULL,

    quantidade INT NOT NULL,
    preco_unitario DECIMAL(10,2) NOT NULL,

    FOREIGN KEY (id_pedido)
        REFERENCES pedidos(id_pedido),

    FOREIGN KEY (id_produto)
        REFERENCES produtos(id_produto),

    CHECK (quantidade > 0),
    CHECK (preco_unitario >= 0)
);


-- ============================================================
-- 8. TABELA DE ENTREGAS
-- Relaciona o pedido ao entregador responsável.
-- ============================================================

CREATE TABLE entregas (
    id_entrega INT AUTO_INCREMENT PRIMARY KEY,

    id_pedido INT NOT NULL UNIQUE,
    id_entregador INT NOT NULL,

    status ENUM(
        'PENDENTE',
        'EM_ROTA',
        'ENTREGUE'
    ) NOT NULL DEFAULT 'PENDENTE',

    data_saida DATETIME NULL,
    data_entrega DATETIME NULL,

    FOREIGN KEY (id_pedido)
        REFERENCES pedidos(id_pedido),

    FOREIGN KEY (id_entregador)
        REFERENCES usuarios(id_usuario)
);


-- ============================================================
-- 9. TABELA DE MOVIMENTAÇÕES DO ESTOQUE
-- Registra entradas, saídas e devoluções.
-- ============================================================

CREATE TABLE movimentacoes_estoque (
    id_movimentacao INT AUTO_INCREMENT PRIMARY KEY,

    id_produto INT NOT NULL,
    id_usuario INT NULL,

    tipo ENUM(
        'ENTRADA',
        'SAIDA',
        'DEVOLUCAO'
    ) NOT NULL,

    quantidade INT NOT NULL,

    motivo VARCHAR(200),

    data_movimentacao DATETIME
        DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (id_produto)
        REFERENCES produtos(id_produto),

    FOREIGN KEY (id_usuario)
        REFERENCES usuarios(id_usuario),

    CHECK (quantidade > 0)
);


